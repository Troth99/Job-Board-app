msgid "Added"
msgstr "Добавено"

msgid "Available companies"
msgstr "Налични компании"

msgid "Browse companies in one clean view."
msgstr "Преглед на компаниите в един чист изглед."

msgid "Clear filter"
msgstr "Изчисти филтъра"

msgid "Compare teams by industry, location, size, and website without losing the visual language of the rest of the app."
msgstr "Сравнете екипите по индустрия, местоположение, размер и уебсайт, без да губите визуалния език на останалата част от приложението."

msgid "Location"
msgstr "Местоположение"

msgid "Name, industry, location, size"
msgstr "Име, индустрия, местоположение, размер"

msgid "No companies found."
msgstr "Няма намерени компании."

msgid "No matches for this filter."
msgstr "Няма съвпадения за този филтър."

msgid "Not provided"
msgstr "Не е предоставено"

msgid "Once companies are created, they will appear here in a structured directory layout."
msgstr "След като компаниите бъдат създадени, те ще се появят тук в структурирано оформление на директорията."

msgid "Search"
msgstr "Търсене"

msgid "shown with the current filter"
msgstr "показани с текущия филтър"

msgid "Try a different company name, city, industry, or team size."
msgstr "Опитайте различно име на компания, град, индустрия или размер на екипа."

msgid "Visit site"
msgstr "Посетете сайта"

msgid "Website"
msgstr "Уебсайт"
